# Copy to .env and fill in. Never commit .env.
# Generate each random value with:  openssl rand -hex 32   (or:  python -c "import secrets; print(secrets.token_hex(32))")

POSTGRES_PASSWORD=change-me
# Break-glass superadmin credential. Keep it offline; use GitLab login day to day.
REKEY_BOOTSTRAP_TOKEN=change-me-to-a-long-random-value

# Port the web UI is published on.
REKEY_PORT=11000
# Address the port is published on. Use 127.0.0.1 when your own nginx on this machine sits in front.
REKEY_BIND=0.0.0.0
# true behind HTTPS (required for real use); false only when trying it on http://localhost.
REKEY_COOKIE_SECURE=true

# GitLab login (see docs/GITLAB-SETUP.md). Leave empty to run without it.
REKEY_OIDC_ISSUER=
REKEY_OIDC_CLIENT_ID=
REKEY_OIDC_CLIENT_SECRET=
# https://<the host users open in their browser>/v1/auth/oidc/callback
REKEY_OIDC_REDIRECT_URI=
REKEY_OIDC_REQUIRED_GROUP=
# GitLab numeric user ids of the people who are Rekey administrators, comma separated.
REKEY_SUPERADMIN_SUBJECTS=
REKEY_CI_AUDIENCE=rekey

# Audit anchoring: copy the audit chain's head hash to a place a database admin cannot rewrite
# (docs/OPERATIONS.md). An https URL that receives a JSON POST {ts, seq, head}; empty = off.
REKEY_AUDIT_ANCHOR_WEBHOOK=
REKEY_AUDIT_ANCHOR_TOKEN=

# Alert email (docs/ALERTS.md). The server, sender and recipients are set in the UI (Alerts page);
# only the SMTP password lives here. Leave empty if your mail server needs no login.
REKEY_SMTP_PASSWORD=

# Optional auto-unseal through a key service you run (docs/AUTO-UNSEAL.md). Off by default: each restart
# then needs the unseal shares. Turn it on here, then enable it once from Security in the UI.
#   REKEY_AUTO_UNSEAL=transit                      # Vault / OpenBao Transit
#   REKEY_AUTO_UNSEAL_ADDR=https://vault.example.com:8200
#   REKEY_AUTO_UNSEAL_KEY=rekey-unseal
#   REKEY_AUTO_UNSEAL_TOKEN=<a token allowed only to encrypt/decrypt with that key>
REKEY_AUTO_UNSEAL=off

# DEVELOPMENT ONLY, never with real secrets: unseal at start from a file of shares (docs/OPERATIONS.md).
# Refuses to run while REKEY_COOKIE_SECURE=true.
# REKEY_DEV_UNSEAL_FILE=./dev-shares.txt
