# Copy to .env and fill in. Never commit .env.
# Generate each random value with:  openssl rand -hex 32   (or:  python -c "import secrets; print(secrets.token_hex(32))")

POSTGRES_PASSWORD=change-me
# Break-glass superadmin credential. Keep it offline; use GitLab login day to day.
REKEY_BOOTSTRAP_TOKEN=change-me-to-a-long-random-value

# Port the web UI is published on.
REKEY_PORT=3000
# true behind HTTPS (required for real use); false only when trying it on http://localhost.
REKEY_COOKIE_SECURE=true

# GitLab login (see docs/GITLAB-SETUP.md). Leave empty to run without it.
REKEY_OIDC_ISSUER=
REKEY_OIDC_CLIENT_ID=
REKEY_OIDC_CLIENT_SECRET=
# https://<the host users open in their browser>/v1/auth/oidc/callback
REKEY_OIDC_REDIRECT_URI=
REKEY_OIDC_REQUIRED_GROUP=
# GitLab numeric user ids of the people who are Rekey administrators, comma separated.
REKEY_SUPERADMIN_SUBJECTS=
REKEY_CI_AUDIENCE=rekey
